{
  "name": "red-panda-browser",
  "version": "0.1.0",
  "description": "An independent experimental browser with Lightpanda-compatible CLI and protocol subsets.",
  "type": "module",
  "private": true,
  "bin": {
    "red-panda": "bin/red-panda.js"
  },
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "start": "node bin/red-panda.js serve",
    "build:native": "node native/build-collections.mjs",
    "test": "npm run test:protocol && npm run test:puppeteer",
    "test:protocol": "node --experimental-vm-modules --test --test-concurrency=1 test/*.test.js",
    "test:puppeteer": "node --experimental-vm-modules scripts/automation.mjs test",
    "build:automation": "node scripts/automation.mjs build",
    "example:puppeteer": "node scripts/automation.mjs run",
    "test:reference": "node scripts/compare-lightpanda.mjs",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "entities": "6.0.1",
    "jsdom": "26.1.0",
    "nwsapi": "2.2.28",
    "tldts": "6.1.86",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "puppeteer-core": "25.16.0",
    "purescript": "0.15.16",
    "spago": "1.0.5"
  }
}
