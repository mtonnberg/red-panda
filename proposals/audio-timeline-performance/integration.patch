+(async()=>{const rows=[],sr=8192,points=[0,2,4,6,7,8,10,11,12,15];const cases=[['backdated-sets',p=>{p.setValueAtTime(3,12/sr);p.setValueAtTime(1,0);p.setValueAtTime(2,4/sr)}],['same-time-sets',p=>{p.setValueAtTime(1,8/sr);p.setValueAtTime(3,4/sr);p.setValueAtTime(2,8/sr)}],['reversed-linear',p=>{p.linearRampToValueAtTime(3,12/sr);p.setValueAtTime(1,4/sr)}],['curve-cancel-point',p=>{p.setValueCurveAtTime([2,4],8/sr,8/sr);p.cancelScheduledValues(0);p.setValueAtTime(7,10/sr)}],['curve-hold-point',p=>{p.setValueCurveAtTime([2,4],0,16/sr);p.cancelAndHoldAtTime(8/sr);p.setValueAtTime(5,12/sr)}],['multiple-curves-cancel',p=>{p.setValueCurveAtTime([1,3],0,4/sr);p.setValueCurveAtTime([5,7],8/sr,4/sr);p.cancelScheduledValues(8/sr);let error;try{p.setValueAtTime(9,2/sr)}catch(e){error=e.name}p.setValueAtTime(11,10/sr);return error}],['curve-readd',p=>{p.setValueCurveAtTime([1,3],0,4/sr);p.cancelScheduledValues(0);p.setValueCurveAtTime([8,10],4/sr,4/sr);try{p.setValueAtTime(9,6/sr)}catch(e){return e.name}}]];
+for(const[name,schedule]of cases){const ctx=new OfflineAudioContext(1,16,sr),source=new ConstantSourceNode(ctx),gain=ctx.createGain();source.connect(gain).connect(ctx.destination);const error=schedule(gain.gain);source.start();const data=(await ctx.startRendering()).getChannelData(0);rows.push({name,error:error??null,samples:points.map(i=>data[i])})}return rows})()
