+test('synchronous Window XHR emits actual metadata using an independently serviced HTTP socket',async t=>{const server=new ThreadWorker(new URL('./sync-http-server.mjs',import.meta.url));t.after(()=>server.terminate());const[info]=await once(server,'message'),base='http://127.0.0.1:'+info.port,browser=new Browser();t.after(()=>browser.close());const page=browser.createPage();await page.navigate(base);const x=new page.dom.window.XMLHttpRequest();x.open('GET',base+'/echo',false);x.send();assert.equal(x.status,200);assert.deepEqual(fields(JSON.parse(x.responseText).headers),['same-origin','cors','empty'])});
