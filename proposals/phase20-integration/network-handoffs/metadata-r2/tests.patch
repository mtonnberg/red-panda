+test('data-worker wire metadata retains actual Native creator principal despite location.origin=null',async t=>{const{w,origin}=await fixture(t),source='onmessage=async()=>{const r=await fetch('+JSON.stringify(origin+'/echo')+');postMessage({origin:location.origin,headers:await r.json()})}',worker=new w.Worker('data:text/javascript,'+encodeURIComponent(source));try{const value=await new Promise((resolve,reject)=>{const timer=setTimeout(()=>reject(Error('Data-worker deadline')),5000);worker.onmessage=e=>{clearTimeout(timer);resolve(e.data)};worker.onerror=e=>{clearTimeout(timer);reject(e.error)};worker.postMessage(null)});assert.equal(value.origin,'null');assert.deepEqual(fields(value.headers),['same-origin','cors','empty'])}finally{worker.terminate()}});
