+import{Worker as ThreadWorker}from'node:worker_threads';import{test}from'node:test';import assert from'node:assert/strict';import http from'node:http';import{once}from'node:events';import{Browser}from'../src/browser.js';
+async function fixture(t){const requests=[],sockets=new Set(),servers=[];let origin;for(let i=0;i<2;i++){const server=http.createServer((q,s)=>{const u=new URL(q.url,'http://owned');requests.push({index:i,url:q.url,headers:q.headers});s.setHeader('access-control-allow-origin',origin??'*');s.setHeader('access-control-allow-credentials','true');if(u.pathname==='/redirect'){s.writeHead(302,{location:u.searchParams.get('to')});s.end();return}if(u.pathname==='/worker.js'){s.setHeader('content-type','text/javascript');s.end(`onmessage=async()=>{const response=await fetch('/echo',{mode:'same-origin'});postMessage(await response.json())}`);return}if(u.pathname==='/echo'){s.setHeader('content-type','application/json');s.end(JSON.stringify(q.headers));return}s.setHeader('content-type','text/html');s.end('<!doctype html><p>Actual metadata')});server.on('connection',x=>{sockets.add(x);x.on('close',()=>sockets.delete(x))});server.listen(0,'::');await once(server,'listening');servers.push(server)}origin='http://127.0.0.1:'+servers[0].address().port;const other='http://127.0.0.1:'+servers[1].address().port,cross='http://localhost:'+servers[1].address().port,browser=new Browser(),page=browser.createPage();t.after(async()=>{browser.close();for(const x of sockets)x.destroy();await Promise.all(servers.map(s=>new Promise(r=>s.close(r))))});await page.navigate(origin);return{w:page.dom.window,page,origin,other,cross,requests}}
+const fields=h=>[h['sec-fetch-site'],h['sec-fetch-mode'],h['sec-fetch-dest']];
+test('actual fetch metadata uses private document origin, request mode and schemeful site',async t=>{const{w,origin,other,cross}=await fixture(t);Object.defineProperty(w,'origin',{value:'http://forged.invalid',configurable:true});Object.defineProperty(w.document,'baseURI',{value:'http://forged.invalid/',configurable:true});for(const[url,mode,site]of[[origin,'cors','same-origin'],[origin,'same-origin','same-origin'],[origin,'no-cors','same-origin'],[other,'cors','same-site'],[cross,'cors','cross-site']]){const h=await(await w.fetch(url+'/echo',{mode,requestMetadata:{origin:'http://forged.invalid',mode:'navigate'},headers:{'sec-fetch-site':'none','sec-ch-ua':'fake'}})).json();assert.deepEqual(fields(h),[site,mode,'empty']);assert.match(h['sec-ch-ua'],/^"RedPanda";v="0"$/);assert.equal(h['sec-ch-ua-full-version-list'],'"RedPanda";v="0.1.0"')}});
+test('actual redirect URL list retains cross-site metadata when returning to origin',async t=>{const{w,origin,cross,requests}=await fixture(t);await w.fetch('/redirect?to='+encodeURIComponent(cross+'/redirect?to='+encodeURIComponent(origin+'/echo')),{mode:'no-cors'});const hops=requests.filter(x=>x.url.startsWith('/redirect')||x.url==='/echo');assert.equal(hops.length,3);assert.deepEqual(hops.map(x=>fields(x.headers)),[['same-origin','no-cors','empty'],['cross-site','no-cors','empty'],['cross-site','no-cors','empty']])});
+test('XHR async and actual dedicated worker apply their own captured request context',async t=>{const{w,origin}=await fixture(t);for(const async of[true]){const x=new w.XMLHttpRequest();x.open('GET','/echo',async);if(async){const done=new Promise(r=>x.onload=r);x.send();await done}else x.send();assert.deepEqual(fields(JSON.parse(x.responseText)),['same-origin','cors','empty'])}const worker=new w.Worker('/worker.js');try{const h=await new Promise((r,j)=>{const timer=setTimeout(()=>j(Error('Worker metadata deadline')),5000);worker.onmessage=e=>{clearTimeout(timer);r(e.data)};worker.onerror=e=>{clearTimeout(timer);j(e.error)};worker.postMessage(null)});assert.deepEqual(fields(h),['same-origin','same-origin','empty'])}finally{worker.terminate()}});
