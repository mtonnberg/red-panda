+ const createdWithParent=new WeakSet(),create=adapter.createElement;
+ adapter.createElement=function(...args){
+  const node=reactions(()=>create.apply(this,args));
+  // Attribute reactions can give this new parser element a real parent.
+  // Retain that insertion while the open-element stack receives its children.
+  if(domSymbolTree.parent(node)!==null)createdWithParent.add(node);
+  return node;
+ };
+ for(const key of['appendChild','insertBefore']){
   const original=adapter[key];
-  adapter[key]=function(...args){return reactions(()=>original.apply(this,args));};
+  adapter[key]=function(parent,node,...args){
+   if(createdWithParent.delete(node))return;
+   return reactions(()=>original.call(this,parent,node,...args));
+  };
  }
 }
 
