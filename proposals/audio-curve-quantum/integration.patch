+(async()=>{const rows=[],sr=8192;for(const length of[16,384])for(const mode of['future-start','inside-start','stop-zero','stop-eight']){const ctx=new OfflineAudioContext(1,length,sr),source=new ConstantSourceNode(ctx,{offset:1});source.connect(ctx.destination);source.offset.setValueCurveAtTime([8,10],0,256/sr);source.start(mode==='future-start'?1:mode==='inside-start'?8/sr:0);if(mode==='stop-zero')source.stop(0);if(mode==='stop-eight')source.stop(8/sr);const data=(await ctx.startRendering()).getChannelData(0);rows.push({length,mode,first:data[0],last:data[length-1],value:source.offset.value,time:ctx.currentTime})}
