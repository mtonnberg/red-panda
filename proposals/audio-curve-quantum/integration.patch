+(async()=>{const rows=[],sr=8192;for(const kind of['gain','offset'])for(const[length,start,duration,second]of[[16,4,8,false],[16,4,8,true],[16,0,256,false],[128,0,256,false],[129,0,256,false],[16,64,128,false]]){const ctx=new OfflineAudioContext(1,length,sr),source=new ConstantSourceNode(ctx,{offset:1}),gain=ctx.createGain();source.connect(gain).connect(ctx.destination);const param=kind==='gain'?gain.gain:source.offset;param.setValueCurveAtTime([8,10],start/sr,duration/sr);if(second)param.setValueAtTime(12,300/sr);source.start();const data=(await ctx.startRendering()).getChannelData(0);rows.push({kind,length,start,duration,second,first:data[0],last:data[length-1],value:param.value,time:ctx.currentTime})}return rows})()
