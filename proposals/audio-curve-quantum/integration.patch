+(async()=>{const rows=[],sr=8192;for(const kind of['gain','offset'])for(const mode of['cancel-zero','hold-now','hold-past','hold-future']){const ctx=new OfflineAudioContext(1,16,sr),source=new ConstantSourceNode(ctx,{offset:1}),gain=ctx.createGain();source.connect(gain).connect(ctx.destination);const p=kind==='gain'?gain.gain:source.offset;p.setValueCurveAtTime([8,10],0,256/sr);source.start();await ctx.startRendering();const before=p.value;let error=null;try{if(mode==='cancel-zero')p.cancelScheduledValues(0);else p.cancelAndHoldAtTime(mode==='hold-now'?ctx.currentTime:mode==='hold-past'?0:1)}catch(e){error=e.name}rows.push({kind,mode,before,after:p.value,error})}return rows})()
