+(async()=>{const rows=[],sr=8192,points=[0,4,6,8,11,12,20,64,127,128,132,136,140,191,192,255,256,383];const cases=[['plain',{}],['cancel-empty',{cancelEmpty:true}],['cancel-curve',{cancelCurve:true}],['reject-point',{reject:true}],['cancel-curve-reject',{cancelCurve:true,reject:true}],['late-event',{late:true}],['earlier-event',{earlier:true}],['starts-at-quantum',{time:128,duration:8}],['starts-inside-next',{time:132,duration:8}],['spans-quantum',{time:64,duration:128}],['explicit-k-rate',{kRate:true}],['read-value',{read:true}]];
+for(const kind of['gain','offset'])for(const[name,options]of cases){const ctx=new OfflineAudioContext(1,384,sr),source=new ConstantSourceNode(ctx,{offset:1}),gain=ctx.createGain();source.connect(gain).connect(ctx.destination);const param=kind==='gain'?gain.gain:source.offset;let error=null;if(options.cancelEmpty)param.cancelScheduledValues(0);if(options.cancelCurve){param.setValueCurveAtTime([1,3],0,4/sr);param.cancelScheduledValues(0)}if(options.earlier)param.setValueAtTime(1,0);if(options.kRate)param.automationRate='k-rate';const time=options.time??4,duration=options.duration??8;param.setValueCurveAtTime([8,10],time/sr,duration/sr);if(options.late)param.setValueAtTime(12,300/sr);if(options.reject)try{param.setValueAtTime(9,(time+2)/sr)}catch(e){error=e.name}const value=options.read?param.value:'not-read';source.start();const data=(await ctx.startRendering()).getChannelData(0);rows.push({kind,name,error,value,automation:param.automationRate,samples:points.map(i=>data[i])})}return rows})()
