+test('bootstrap consumes its sole transfer property and later calls preserve authored lookalike properties',t=>{const context=vm.createContext({}),lookalike=vm.runInContext('({actual:1})',context);context.__redpanda_invocation_authored=lookalike;const before=Reflect.ownKeys(context),adapter=createInvocationTrampoline(context);t.after(()=>adapter.dispose());assert.deepEqual(Reflect.ownKeys(context),before);const value=adapter.invokeDeclaration('function(){return __redpanda_invocation_authored}',undefined,[],{timeout:100});assert.strictEqual(value,lookalike);assert.deepEqual(Reflect.ownKeys(context),before);const bridge=vm.runInContext(adapter.binding,context);assert.equal(Object.getPrototypeOf(bridge),null);assert.equal(Object.isFrozen(bridge),true);assert.deepEqual(Reflect.ownKeys(bridge),['run','inspect']);assert.equal(binding.sameRealm(bridge,[]),true);assert.equal(binding.sameRealm(bridge.run,[]),true);assert.equal(Object.getPrototypeOf(bridge.run),null);assert.equal(bridge.run.constructor,undefined);assert.equal(bridge.enter,undefined);});
