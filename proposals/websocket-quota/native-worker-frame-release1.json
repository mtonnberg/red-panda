  "expression": "(async()=>{const rows=[],f=document.createElement('iframe');document.body.appendChild(f);const worker=new f.contentWindow.Worker('/worker.js'),ready=new Promise(r=>worker.onmessage=e=>r(e.data));worker.postMessage({command:'hold',id:'frame-worker',count:1});rows.push(['held',await ready]);f.remove();for(const delay of[0,20]){if(delay)await new Promise(r=>setTimeout(r,delay));rows.push(['after-'+delay,await new Promise(resolve=>{const s=new WebSocket(\"ws://127.0.0.1:44765\"+'/?main=frameWorker'+delay),events=[];s.onopen=()=>{events.push('open');s.close()};s.onerror=()=>events.push('error');s.onclose=e=>{events.push(['close',e.code,e.wasClean]);resolve(events)}})])}return JSON.stringify(rows)})()\n",
