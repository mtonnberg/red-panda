  "expression": "(async()=>{const rows=[],f=document.createElement('iframe');document.body.appendChild(f);const ws=new f.contentWindow.WebSocket(\"ws://127.0.0.1:44145\"+'/?frame=held');await new Promise(r=>ws.onopen=r);f.remove();const after=label=>new Promise(resolve=>{const s=new WebSocket(\"ws://127.0.0.1:44145\"+'/?main='+label),events=[['created',s.readyState]];s.onopen=()=>{events.push('open');s.close()};s.onerror=()=>events.push('error');s.onclose=e=>{events.push(['close',e.code,e.wasClean]);resolve(events)}});rows.push(['after-remove',await after('immediate')]);await new Promise(r=>setTimeout(r,20));rows.push(['after-task',await after('task')]);return JSON.stringify(rows)})()\n",
