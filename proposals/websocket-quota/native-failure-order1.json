  "expression": "(async()=>{const rows=[],all=[],attempt=(label,path='/')=>new Promise(resolve=>{const events=[],ws=new WebSocket(\"ws://127.0.0.1:38171\"+path+'?id='+label);all.push(ws);events.push(['constructed',ws.readyState]);Promise.resolve().then(()=>events.push(['microtask',ws.readyState]));ws.onopen=()=>{events.push(['open',ws.readyState]);resolve({events,ws})};ws.onerror=()=>events.push(['error',ws.readyState]);ws.onclose=e=>{events.push(['close',ws.readyState,e.code,e.reason,e.wasClean]);resolve({events,ws})}});const first=await attempt('hold');rows.push(['held',first.events]);const denied=await attempt('denied');rows.push(['denied',denied.events]);first.ws.close(1000,'release');rows.push(['closing-state',first.ws.readyState]);const onclose=new Promise(resolve=>first.ws.onclose=async()=>{const q=await attempt('inside-close');rows.push(['inside-close',q.events]);q.ws.close();resolve()});await onclose;await new Promise(r=>setTimeout(r,10));const pending=new WebSocket(\"ws://127.0.0.1:38171\"+'/hang');const events=[['constructed',pending.readyState]];pending.onopen=()=>events.push('unexpected-open');pending.onerror=()=>events.push('error');const complete=new Promise(resolve=>pending.onclose=e=>{events.push(['close',e.code,e.reason,e.wasClean,pending.readyState]);resolve()});pending.close(3000,'cancel');events.push(['after-close',pending.readyState]);const next=await attempt('after-pending-cancel');rows.push(['pending-cancel',events],['after-cancel',next.events]);next.ws.close();await complete;return JSON.stringify(rows)})()\n",
