-IsolateData::~IsolateData() {}
+IsolateData::~IsolateData() {
+  // Last-live-Data release resets weak cells while the Isolate is still alive.
+  // No process-global V8 handle remains after this shared state disappears.
+  owned_global_proxy_reservations_.reset();
+  Mutex::ScopedLock lock(isolate_data_mutex_);
+  std::erase_if(owned_global_proxy_registry_, [](const auto& item) {
+    return item.second.expired();
+  });
+}
+
+bool IsolateData::IsReservedOwnedGlobalProxy(Local<Object> value) {
+  HandleScope scope(isolate_);
+  owned_global_proxy_reservations_->Prune();
+  for (const auto& cell : owned_global_proxy_reservations_->entries) {
+    if (cell->Get(isolate_) == value) return true;
+  }
+  return false;
+}
+
+void IsolateData::ReserveOwnedGlobalProxy(Local<Object> value) {
+  CHECK(!value.IsEmpty());
+  if (IsReservedOwnedGlobalProxy(value)) return;
+  auto cell = std::make_unique<v8::Global<Object>>(isolate_, value);
+  cell->SetWeak();  // No callback, owner pointer, strong root, or author code.
+  owned_global_proxy_reservations_->entries.push_back(std::move(cell));
+}
 
