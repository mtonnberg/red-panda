+                                                global_template,
+                                                security_token,
+                                                options,
+                                                previous_carrier);
+}
+
+v8::MaybeLocal<v8::Context> GetOwnedContext(
+    Environment* env, v8::Local<v8::Object> carrier) {
+  contextify::ContextifyContext* owned =
+      contextify::ContextifyContext::FromOwnedCarrier(env, carrier);
+  if (owned == nullptr) return {};
+  return owned->context();
+}
+
+v8::MaybeLocal<v8::Object> DetachOwnedContext(
+    Environment* env, v8::Local<v8::Object> carrier) {
+  return contextify::ContextifyContext::DetachOwned(env, carrier);
+}
 }  // namespace node
 
 NODE_BINDING_CONTEXT_AWARE_INTERNAL(
