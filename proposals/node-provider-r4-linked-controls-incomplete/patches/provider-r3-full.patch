+// Node owns this ticket and its HDO. It is intentionally not yet a vm.Context.
+void ContextifyContext::PrepareOwnedContext(
+    const FunctionCallbackInfo<Value>& args) {
+  Environment* env = Environment::GetCurrent(args);
+  Isolate* isolate = env->isolate();
+  CHECK_EQ(args.Length(), 1);
+  CHECK(args[0]->IsSymbol());
+  if (env->isolate_data()->is_building_snapshot()) {
+    THROW_ERR_INVALID_STATE(isolate,
+                            "Owned contexts are not supported in snapshots");
+    return;
+  }
+  Local<Context> host = env->context();
+  Context::Scope scope(host);
+  Local<Object> carrier = Object::New(isolate);
+  if (carrier->SetPrototype(host, v8::Null(isolate)).IsNothing() ||
+      carrier->SetPrivate(host,
+                          env->owned_context_pending_symbol(),
+                          v8::True(isolate)).IsNothing() ||
+      carrier->SetPrivate(host,
+                          env->host_defined_option_symbol(),
+                          args[0]).IsNothing()) {
+    return;
+  }
+  args.GetReturnValue().Set(carrier);
+}
+
+ContextifyContext* ContextifyContext::FromOwnedCarrier(
+    Environment* env, Local<Object> carrier) {
+  ContextifyContext* contextify =
+      carrier.IsEmpty() ? nullptr : ContextFromContextifiedSandbox(env, carrier);
+  if (contextify == nullptr || contextify->realm() == nullptr ||
+      contextify->env() != env ||
+      !contextify->owned_ || contextify->context_.IsEmpty() ||
+      !ContextEmbedderTag::IsNodeContext(contextify->context()) ||
+      Environment::GetCurrent(contextify->context()) != env ||
+      contextify->context()->GetAlignedPointerFromEmbedderData(
+          ContextEmbedderIndex::kContextifyContext) != contextify ||
+      !contextify->context()->GetEmbedderData(
+          ContextEmbedderIndex::kOwnedContextCarrier)->StrictEquals(carrier)) {
+    THROW_ERR_INVALID_STATE(env->isolate(), "Not an owned context carrier");
+    return nullptr;
+  }
+  return contextify;
+}
+
+MaybeLocal<Value> ContextifyContext::GetOwnedImportId(
+    Environment* env, Local<Context> context) {
+  Local<Value> anchor =
+      context->GetEmbedderData(ContextEmbedderIndex::kOwnedContextCarrier);
+  if (!anchor->IsObject()) {
+    THROW_ERR_INVALID_STATE(env->isolate(), "Missing owned context carrier");
+    return {};
+  }
+  Local<Object> carrier = anchor.As<Object>();
+  ContextifyContext* owned = FromOwnedCarrier(env, carrier);
+  if (owned == nullptr) return {};
+  if (owned->context() != context) {
+    THROW_ERR_INVALID_STATE(env->isolate(), "Owned context authority mismatch");
+    return {};
+  }
+  Local<Value> id;
+  if (!carrier->GetPrivate(env->context(), env->host_defined_option_symbol())
+           .ToLocal(&id)) {
+    return {};
+  }
+  if (!id->IsSymbol()) {
+    THROW_ERR_INVALID_STATE(env->isolate(), "Missing owned context import id");
+    return {};
+  }
+  return id;
+}
+
+MaybeLocal<Context> ContextifyContext::NewOwned(
+    Environment* env,
+    Local<Object> carrier,
+    Local<ObjectTemplate> global_template,
+    Local<Value> security_token,
+    const OwnedContextOptions& public_options,
+    Local<Object> previous_carrier) {
+  Isolate* isolate = env->isolate();
+  EscapableHandleScope scope(isolate);
+  if (env->isolate_data()->is_building_snapshot() || carrier.IsEmpty() ||
+      global_template.IsEmpty() || security_token.IsEmpty()) {
+    THROW_ERR_INVALID_STATE(isolate, "Invalid owned context creation");
+    return {};
+  }
+  // Private symbols are per-Isolate. Also require the exact Host creation
+  // Context so a ticket from a second Environment cannot cross registries.
+  Local<Context> carrier_context;
+  if (!carrier->GetCreationContext().ToLocal(&carrier_context) ||
+      carrier_context != env->context()) {
+    THROW_ERR_INVALID_STATE(isolate, "Owned ticket belongs to another Environment");
+    return {};
+  }
+  // A pending ticket can have been consumed by ordinary vm.createContext().
+  // Its private pending mark then remains true, but the genuine canonical
+  // wrapper/HDO now belong to that ordinary Context. Never replace them.
+  v8::Maybe<bool> has_context = carrier->HasPrivate(
+      env->context(), env->contextify_context_private_symbol());
+  if (has_context.IsNothing()) return {};
+  if (has_context.FromJust()) {
+    Local<Value> existing_wrapper;
+    if (!carrier->GetPrivate(env->context(),
+                              env->contextify_context_private_symbol())
+             .ToLocal(&existing_wrapper)) {
+      return {};
+    }
+    ContextifyContext* existing = existing_wrapper->IsObject()
+        ? Unwrap<ContextifyContext>(existing_wrapper.As<Object>())
+        : nullptr;
+    THROW_ERR_INVALID_STATE(isolate, existing != nullptr
+        ? "Owned ticket is already contextified"
+        : "Owned ticket has occupied Contextify authority");
+    return {};
+  }
+  Local<Value> pending;
+  Local<Value> id;
+  if (!carrier->GetPrivate(env->context(), env->owned_context_pending_symbol())
+           .ToLocal(&pending) ||
+      !carrier->GetPrivate(env->context(), env->host_defined_option_symbol())
+           .ToLocal(&id)) {
+    return {};
+  }
+  if (!pending->IsTrue() || !id->IsSymbol()) {
+    THROW_ERR_INVALID_STATE(isolate, "Expected an unused owned context ticket");
+    return {};
+  }
+
+  Local<Object> proxy;
+  ContextifyContext* previous = nullptr;
+  if (!previous_carrier.IsEmpty()) {
+    previous = FromOwnedCarrier(env, previous_carrier);
+    if (previous == nullptr) return {};
+    if (!previous->owned_detached_ || previous->owned_reuse_consumed_ ||
+        previous->owned_proxy_.IsEmpty() ||
+        previous->owned_template_.Get(isolate) != global_template) {
+      THROW_ERR_INVALID_STATE(isolate, "Invalid owned global reuse lease");
+      return {};
+    }
+    proxy = previous->owned_proxy_.Get(isolate);
+  }
+
+  // Creation and reuse attempts consume their tickets even on allocation
+  // failure. No retry may operate on a possibly partially reset global proxy.
+  if (carrier->SetPrivate(env->context(),
+                          env->owned_context_pending_symbol(),
+                          v8::False(isolate)).IsNothing()) {
+    return {};
+  }
+  if (previous != nullptr) {
+    previous->owned_reuse_consumed_ = true;
+    previous->owned_proxy_.Reset();
+  }
+
+  ContextOptions options;
+  options.vanilla = true;
+  options.name = public_options.name.IsEmpty()
+                     ? FIXED_ONE_BYTE_STRING(isolate, "Owned VM Context")
+                     : public_options.name;
+  options.origin = public_options.origin;
+  options.allow_code_gen_strings =
+      Boolean::New(isolate, public_options.code_generation_strings);
+  options.allow_code_gen_wasm =
+      Boolean::New(isolate, public_options.code_generation_wasm);
+  options.host_defined_options_id = id.As<Symbol>();
+  options.owned_carrier = carrier;
+  options.owned_security_token = security_token;
+  if (public_options.own_microtask_queue) {
+    options.own_microtask_queue =
+        MicrotaskQueue::New(isolate, MicrotasksPolicy::kExplicit);
+  }
+  MicrotaskQueue* queue = options.own_microtask_queue
+                              ? options.own_microtask_queue.get()
+                              : isolate->GetCurrentContext()->GetMicrotaskQueue();
+  // Intentionally bypass the stock interceptor-backed VM snapshot. V8's
+  // actual compatible global template/proxy creation does the reuse.
+  Local<Context> context = Context::New(isolate,
+                                        nullptr,
+                                        global_template,
+                                        proxy,
+                                        {},
+                                        queue);
+  if (context.IsEmpty()) return {};
+  // Reserve the actual raw identity before Node initialization/publication.
+  // It stays reserved through active, detached and reused states.
+  env->isolate_data()->ReserveOwnedGlobalProxy(context->Global());
+  if (InitializeBaseContextForSnapshot(context).IsNothing()) return {};
+  ContextifyContext* result = New(context, env, {}, &options);
+  if (result == nullptr) return {};
+  result->owned_template_.Reset(isolate, global_template);
+  result->owned_proxy_.Reset(isolate, context->Global());
+  return scope.Escape(context);
+}
+
+MaybeLocal<Object> ContextifyContext::DetachOwned(
+    Environment* env, Local<Object> carrier) {
+  ContextifyContext* owned = FromOwnedCarrier(env, carrier);
+  if (owned == nullptr) return {};
+  if (owned->owned_detached_ || owned->owned_proxy_.IsEmpty()) {
+    THROW_ERR_INVALID_STATE(env->isolate(), "Owned global already detached");
+    return {};
+  }
+  // Caller must quiesce actual document execution first. No stack/URL/global
+  // property heuristic can manufacture that lifetime guarantee here.
+  Local<Object> proxy = owned->owned_proxy_.Get(env->isolate());
+  owned->context()->DetachGlobal();
+  owned->owned_detached_ = true;
+  return proxy;
+}
