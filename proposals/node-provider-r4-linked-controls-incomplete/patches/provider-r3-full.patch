diff --git a/test/cctest/test_owned_context_collision.cc b/test/cctest/test_owned_context_collision.cc
new file mode 100644
--- /dev/null
+++ b/test/cctest/test_owned_context_collision.cc
@@ -0,0 +1,98 @@
+// SOURCE ONLY, UNCOMPILED/UNRUN. R2 over the exact frozen provider R1.
+#include <cppgc/persistent.h>
+#include <node.h>
+#include <v8.h>
+#include "node_contextify.h"
+#include "node_test_fixture.h"
+
+using node::contextify::ContextifyContext;
+using namespace v8;
+class OwnedContextCollisionTest : public EnvironmentTestFixture {};
+namespace {
+struct Roots {
+  Global<Function> retained;
+  Global<Context> weak_context;
+  Global<Object> weak_carrier;
+  Global<Object> weak_wrapper;
+  cppgc::WeakPersistent<ContextifyContext> weak_cppgc;
+};
+V8_NOINLINE void PrepareOrdinaryAfterRejection(
+    Isolate* isolate, node::Environment* env, Local<Context> host, Roots* roots) {
+  HandleScope handles(isolate);
+  Local<Object> carrier = node::LoadEnvironment(env,
+      "const vm=require('node:vm');"
+      "return vm.createContext(vm.prepareOwnedContext());")
+      .ToLocalChecked().As<Object>();
+  auto* before = ContextifyContext::ContextFromContextifiedSandbox(env, carrier);
+  ASSERT_NE(before, nullptr);
+  ASSERT_FALSE(before->is_owned());
+  Local<Context> ordinary = before->context();
+  Local<Object> original_wrapper = before->object(isolate);
+  Local<Value> original_id = carrier->GetPrivate(
+      host, env->host_defined_option_symbol()).ToLocalChecked();
+  {
+    TryCatch caught(isolate);
+    node::OwnedContextOptions options;
+    ASSERT_TRUE(node::CreateOwnedContext(env, carrier,
+        ObjectTemplate::New(isolate), host->GetSecurityToken(), options).IsEmpty());
+    ASSERT_TRUE(caught.HasCaught());
+    Local<Value> code = caught.Exception().As<Object>()->Get(
+        host, String::NewFromUtf8Literal(isolate, "code")).ToLocalChecked();
+    ASSERT_TRUE(code->StrictEquals(
+        String::NewFromUtf8Literal(isolate, "ERR_INVALID_STATE")));
+  }
+  auto* after = ContextifyContext::ContextFromContextifiedSandbox(env, carrier);
+  ASSERT_EQ(after, before);
+  ASSERT_EQ(after->context(), ordinary);
+  ASSERT_EQ(after->object(isolate), original_wrapper);
+  ASSERT_TRUE(carrier->GetPrivate(host, env->host_defined_option_symbol())
+      .ToLocalChecked()->StrictEquals(original_id));
+  ASSERT_TRUE(carrier->GetPrivate(host, env->owned_context_pending_symbol())
+      .ToLocalChecked()->IsTrue());
+  ASSERT_TRUE(ordinary->GetEmbedderData(node::ContextEmbedderIndex::kSandboxObject)
+      ->StrictEquals(carrier));
+  roots->weak_cppgc = after;
+  roots->weak_context.Reset(isolate, ordinary);
+  roots->weak_context.SetWeak();
+  roots->weak_carrier.Reset(isolate, carrier);
+  roots->weak_carrier.SetWeak();
+  roots->weak_wrapper.Reset(isolate, original_wrapper);
+  roots->weak_wrapper.SetWeak();
+  Context::Scope scope(ordinary);
+  Local<Function> fn = Script::Compile(ordinary,
+      String::NewFromUtf8Literal(isolate, "globalThis.marker=23; ()=>marker"))
+      .ToLocalChecked()->Run(ordinary).ToLocalChecked().As<Function>();
+  roots->retained.Reset(isolate, fn);
+}
+V8_NOINLINE void CheckRetained(Isolate* isolate,
+                               Local<Context> host, Roots* roots) {
+  HandleScope handles(isolate);
+  EXPECT_NE(roots->weak_cppgc.Get(), nullptr);
+  EXPECT_EQ(roots->retained.Get(isolate)
+      ->Call(host, Undefined(isolate), 0, nullptr).ToLocalChecked()
+      .As<Number>()->Value(), 23);
+}
+}  // namespace
+TEST_F(OwnedContextCollisionTest, RejectPreservesOrdinaryWrapperAndRetention) {
+  const HandleScope handles(isolate_);
+  const Argv argv;
+  Env env{handles, argv};
+  Roots roots;
+  PrepareOrdinaryAfterRejection(isolate_, *env, env.context(), &roots);
+  ASSERT_FALSE(roots.retained.IsEmpty());
+  isolate_->LowMemoryNotification();
+  platform->DrainTasks(isolate_);
+  ASSERT_FALSE(roots.weak_context.IsEmpty());
+  ASSERT_FALSE(roots.weak_carrier.IsEmpty());
+  ASSERT_FALSE(roots.weak_wrapper.IsEmpty());
+  CheckRetained(isolate_, env.context(), &roots);
+  roots.retained.Reset();
+  for (int i = 0; i < 8; ++i) {
+    isolate_->LowMemoryNotification();
+    platform->DrainTasks(isolate_);
+  }
+  EXPECT_TRUE(roots.weak_context.IsEmpty());
+  EXPECT_TRUE(roots.weak_carrier.IsEmpty());
+  EXPECT_TRUE(roots.weak_wrapper.IsEmpty());
+  EXPECT_EQ(roots.weak_cppgc.Get(), nullptr);
+}
diff --git a/test/cctest/test_owned_context_provider.cc b/test/cctest/test_owned_context_provider.cc
new file mode 100644
--- /dev/null
+++ b/test/cctest/test_owned_context_provider.cc
@@ -0,0 +1,112 @@
+// UNCOMPILED/UNRUN. Real Node-internal cppgc lifetime observation; no addon
+// private-slot writes or synthetic wrapper identities.
+#include <cppgc/persistent.h>
+#include <node.h>
+#include <v8.h>
+#include "node_contextify.h"
+#include "node_test_fixture.h"
+
+using node::contextify::ContextifyContext;
+using namespace v8;
+class OwnedContextProviderTest : public EnvironmentTestFixture {};
+
+namespace {
+struct ObservedRoots {
+  Global<Function> retained;
+  Global<Context> weak_context;
+  Global<Object> weak_carrier;
+  Global<Object> weak_wrapper;
+  cppgc::WeakPersistent<ContextifyContext> weak_cppgc;
+};
+// Keep raw setup pointers and temporary Local handles out of the collecting
+// caller's live frame; otherwise a conservative stack root can spoil the test.
+V8_NOINLINE void PrepareRoots(Isolate* isolate,
+                              node::Environment* env,
+                              Local<Context> host,
+                              ObservedRoots* roots) {
+  HandleScope handles(isolate);
+  Local<Value> ticket = node::LoadEnvironment(
+      env, "return require('node:vm').prepareOwnedContext();").ToLocalChecked();
+  ASSERT_TRUE(ticket->IsObject());
+  Local<Object> carrier = ticket.As<Object>();
+  Local<ObjectTemplate> global_template = ObjectTemplate::New(isolate);
+  node::OwnedContextOptions options;
+  Local<Context> owned = node::CreateOwnedContext(
+      env, carrier, global_template, host->GetSecurityToken(), options)
+      .ToLocalChecked();
+  auto* backend = ContextifyContext::FromOwnedCarrier(env, carrier);
+  ASSERT_NE(backend, nullptr);
+  ASSERT_EQ(backend->context(), owned);
+  roots->weak_cppgc = backend;
+  roots->weak_context.Reset(isolate, owned);
+  roots->weak_context.SetWeak();
+  roots->weak_carrier.Reset(isolate, carrier);
+  roots->weak_carrier.SetWeak();
+  roots->weak_wrapper.Reset(isolate, backend->object(isolate));
+  roots->weak_wrapper.SetWeak();
+  Context::Scope owner_scope(owned);
+  Local<Function> function = Script::Compile(
+      owned, String::NewFromUtf8Literal(isolate, "()=>42"))
+      .ToLocalChecked()->Run(owned).ToLocalChecked().As<Function>();
+  roots->retained.Reset(isolate, function);
+}
+V8_NOINLINE void CheckActualRetainedFunction(Isolate* isolate,
+                                            Local<Context> host,
+                                            ObservedRoots* roots) {
+  HandleScope handles(isolate);
+  EXPECT_NE(roots->weak_cppgc.Get(), nullptr);
+  Local<Value> answer = roots->retained.Get(isolate)
+      ->Call(host, Undefined(isolate), 0, nullptr).ToLocalChecked();
+  EXPECT_EQ(answer.As<Number>()->Value(), 42);
+}
+}  // namespace
+
+TEST_F(OwnedContextProviderTest, RetainedClosureRootsActualCarrierAndCppgc) {
+  const HandleScope outer_handles(isolate_);
+  const Argv argv;
+  Env env{outer_handles, argv};
+  ObservedRoots roots;
+  PrepareRoots(isolate_, *env, env.context(), &roots);
+  ASSERT_FALSE(roots.retained.IsEmpty());
+  // Only the real old function is a strong application root.
+  isolate_->LowMemoryNotification();
+  platform->DrainTasks(isolate_);
+  ASSERT_FALSE(roots.weak_context.IsEmpty());
+  ASSERT_FALSE(roots.weak_carrier.IsEmpty());
+  ASSERT_FALSE(roots.weak_wrapper.IsEmpty());
+  CheckActualRetainedFunction(isolate_, env.context(), &roots);
+  roots.retained.Reset();
+  // Bounded observation, not an assertion replacement if collection fails.
+  for (int i = 0; i < 8; ++i) {
+    isolate_->LowMemoryNotification();
+    platform->DrainTasks(isolate_);
+  }
+  EXPECT_TRUE(roots.weak_context.IsEmpty());
+  EXPECT_TRUE(roots.weak_carrier.IsEmpty());
+  EXPECT_TRUE(roots.weak_wrapper.IsEmpty());
+  EXPECT_EQ(roots.weak_cppgc.Get(), nullptr);
+}
+
+TEST_F(OwnedContextProviderTest, RejectsTicketFromDifferentEnvironment) {
+  const HandleScope handles(isolate_);
+  const Argv argv;
+  Env first{handles, argv};
+  Local<Object> ticket = node::LoadEnvironment(
+      *first, "return require('node:vm').prepareOwnedContext();")
+      .ToLocalChecked().As<Object>();
+  {
+    Env second{handles, argv};
+    node::LoadEnvironment(*second, "return 1;").ToLocalChecked();
+    TryCatch caught(isolate_);
+    node::OwnedContextOptions options;
+    EXPECT_TRUE(node::CreateOwnedContext(
+        *second, ticket, ObjectTemplate::New(isolate_),
+        second.context()->GetSecurityToken(), options).IsEmpty());
+    ASSERT_TRUE(caught.HasCaught());
+    Local<Value> code = caught.Exception().As<Object>()->Get(
+        second.context(), String::NewFromUtf8Literal(isolate_, "code"))
+        .ToLocalChecked();
+    EXPECT_TRUE(code->StrictEquals(
+        String::NewFromUtf8Literal(isolate_, "ERR_INVALID_STATE")));
+  }
+}
diff --git a/test/cctest/test_owned_proxy_reservations.cc b/test/cctest/test_owned_proxy_reservations.cc
new file mode 100644
--- /dev/null
+++ b/test/cctest/test_owned_proxy_reservations.cc
@@ -0,0 +1,152 @@
+// SOURCE ONLY, UNCOMPILED/UNRUN. Shared eligibility, not provenance or branding.
+#include <cppgc/persistent.h>
+#include <node.h>
+#include <v8.h>
+#include "env-inl.h"
+#include "node_contextify.h"
+#include "node_test_fixture.h"
+
+using node::contextify::ContextifyContext;
+using namespace v8;
+class OwnedProxyReservationsTest : public EnvironmentTestFixture {};
+namespace {
+void RejectRaw(Local<Context> host,
+               Local<Function> ordinary_factory,
+               node::Environment* env,
+               Local<Object> raw) {
+  auto* isolate=host->GetIsolate();
+  Context::Scope scope(host);
+  EXPECT_TRUE(env->isolate_data()->IsReservedOwnedGlobalProxy(raw));
+  TryCatch caught(isolate);
+  Local<Value> args[]={raw};
+  EXPECT_TRUE(ordinary_factory->Call(host,Undefined(isolate),1,args).IsEmpty());
+  ASSERT_TRUE(caught.HasCaught());
+  auto code=caught.Exception().As<Object>()->Get(host,
+      String::NewFromUtf8Literal(isolate,"code")).ToLocalChecked();
+  EXPECT_TRUE(code->StrictEquals(String::NewFromUtf8Literal(isolate,"ERR_INVALID_STATE")));
+  EXPECT_FALSE(raw->HasPrivate(host,env->contextify_context_private_symbol()).FromJust());
+  EXPECT_FALSE(raw->HasPrivate(host,env->host_defined_option_symbol()).FromJust());
+}
+struct WeakRoots {
+  Global<Function> retained;
+  Global<Context> context;
+  Global<Object> carrier;
+  Global<Object> wrapper;
+  Global<Object> proxy;
+  cppgc::WeakPersistent<ContextifyContext> cppgc;
+};
+V8_NOINLINE void PrepareWeak(Isolate* isolate,node::Environment* env,
+                             Local<Context> host,WeakRoots* roots) {
+  HandleScope handles(isolate);
+  auto carrier=node::LoadEnvironment(env,
+      "return require('node:vm').prepareOwnedContext();").ToLocalChecked().As<Object>();
+  node::OwnedContextOptions options;
+  auto context=node::CreateOwnedContext(env,carrier,ObjectTemplate::New(isolate),
+      host->GetSecurityToken(),options).ToLocalChecked();
+  auto* cppgc=ContextifyContext::FromOwnedCarrier(env,carrier);
+  ASSERT_NE(cppgc,nullptr);
+  roots->cppgc=cppgc;
+  roots->context.Reset(isolate,context);roots->context.SetWeak();
+  roots->carrier.Reset(isolate,carrier);roots->carrier.SetWeak();
+  roots->wrapper.Reset(isolate,cppgc->object(isolate));roots->wrapper.SetWeak();
+  roots->proxy.Reset(isolate,context->Global());roots->proxy.SetWeak();
+  EXPECT_TRUE(env->isolate_data()->IsReservedOwnedGlobalProxy(context->Global()));
+  Context::Scope scope(context);
+  auto fn=Script::Compile(context,String::NewFromUtf8Literal(isolate,"()=>42"))
+      .ToLocalChecked()->Run(context).ToLocalChecked().As<Function>();
+  roots->retained.Reset(isolate,fn);
+}
+V8_NOINLINE void CheckKept(Isolate* isolate,Local<Context> host,WeakRoots* roots) {
+  HandleScope handles(isolate);
+  EXPECT_NE(roots->cppgc.Get(),nullptr);
+  EXPECT_EQ(roots->retained.Get(isolate)->Call(host,Undefined(isolate),0,nullptr)
+      .ToLocalChecked().As<Number>()->Value(),42);
+}
+}  // namespace
+
+TEST_F(OwnedProxyReservationsTest, TwoLiveDataShareActiveDetachedReusedReservation) {
+  const HandleScope handles(isolate_);
+  const Argv argv;
+  Env first{handles,argv};
+  auto host=first.context();
+  auto prepare=node::LoadEnvironment(*first,
+      "return require('node:vm').prepareOwnedContext;").ToLocalChecked().As<Function>();
+  auto carrier=prepare->Call(host,Undefined(isolate_),0,nullptr).ToLocalChecked().As<Object>();
+  auto global_template=ObjectTemplate::New(isolate_);
+  node::OwnedContextOptions options;
+  auto owned=node::CreateOwnedContext(*first,carrier,global_template,
+      host->GetSecurityToken(),options).ToLocalChecked();
+  auto raw=owned->Global();
+  uv_loop_t other_loop;
+  ASSERT_EQ(uv_loop_init(&other_loop),0);
+  auto free_data=[](node::IsolateData* value){node::FreeIsolateData(value);};
+  std::unique_ptr<node::IsolateData,decltype(free_data)> other_data{
+      node::CreateIsolateData(isolate_,&other_loop,platform.get()),free_data};
+  ASSERT_NE(other_data.get(),isolate_data_);
+  ASSERT_EQ(other_data->isolate(),isolate_data_->isolate());
+  {
+    auto other_context=node::NewContext(isolate_);
+    Context::Scope scope(other_context);
+    auto free_env=[](node::Environment* value){node::FreeEnvironment(value);};
+    std::unique_ptr<node::Environment,decltype(free_env)> other_env{
+        node::CreateEnvironment(other_data.get(),other_context,{},{}),free_env};
+    ASSERT_NE(other_env.get(),nullptr);
+    // Shared-token control isolates the eligibility gate from an earlier SOP
+    // denial. It does not establish distinct-origin policy or Promise support.
+    other_context->SetSecurityToken(host->GetSecurityToken());
+    auto factory=node::LoadEnvironment(other_env.get(),
+        "return value=>require('node:vm').createContext(value);")
+        .ToLocalChecked().As<Function>();
+    RejectRaw(other_context,factory,other_env.get(),raw);
+    EXPECT_EQ(node::DetachOwnedContext(*first,carrier).ToLocalChecked(),raw);
+    RejectRaw(other_context,factory,other_env.get(),raw);
+    Local<Object> fresh;
+    {
+      Context::Scope first_scope(host);
+      fresh=prepare->Call(host,Undefined(isolate_),0,nullptr).ToLocalChecked().As<Object>();
+      EXPECT_EQ(node::CreateOwnedContext(*first,fresh,global_template,
+          host->GetSecurityToken(),options,carrier).ToLocalChecked()->Global(),raw);
+    }
+    RejectRaw(other_context,factory,other_env.get(),raw);
+    // Nonreserved values still receive actual canonical ordinary contexts.
+    auto plain=Object::New(isolate_);
+    plain->CreateDataProperty(other_context,
+        String::NewFromUtf8Literal(isolate_,"answer"),Integer::New(isolate_,40)).Check();
+    Local<Value> argument[]={plain};
+    EXPECT_EQ(factory->Call(other_context,Undefined(isolate_),1,argument)
+        .ToLocalChecked(),plain);
+    auto* ordinary=ContextifyContext::ContextFromContextifiedSandbox(other_env.get(),plain);
+    ASSERT_NE(ordinary,nullptr);
+    Context::Scope ordinary_scope(ordinary->context());
+    EXPECT_EQ(Script::Compile(ordinary->context(),
+        String::NewFromUtf8Literal(isolate_,"answer+=2;answer")).ToLocalChecked()
+        ->Run(ordinary->context()).ToLocalChecked().As<Number>()->Value(),42);
+  }
+  other_data.reset(); // First Data remains; weak reservations must survive.
+  EXPECT_TRUE(isolate_data_->IsReservedOwnedGlobalProxy(raw));
+  EXPECT_EQ(uv_loop_close(&other_loop),0);
+}
+
+TEST_F(OwnedProxyReservationsTest, ReservationDoesNotRootActualContextOrProxy) {
+  const HandleScope handles(isolate_);
+  const Argv argv;
+  Env env{handles,argv};
+  WeakRoots roots;
+  PrepareWeak(isolate_,*env,env.context(),&roots);
+  ASSERT_FALSE(roots.retained.IsEmpty());
+  isolate_->LowMemoryNotification();platform->DrainTasks(isolate_);
+  EXPECT_FALSE(roots.context.IsEmpty());
+  EXPECT_FALSE(roots.carrier.IsEmpty());
+  EXPECT_FALSE(roots.wrapper.IsEmpty());
+  EXPECT_FALSE(roots.proxy.IsEmpty());
+  CheckKept(isolate_,env.context(),&roots);
+  roots.retained.Reset();
+  for(int i=0;i<8;++i){isolate_->LowMemoryNotification();platform->DrainTasks(isolate_);}
+  EXPECT_TRUE(roots.context.IsEmpty());
+  EXPECT_TRUE(roots.carrier.IsEmpty());
+  EXPECT_TRUE(roots.wrapper.IsEmpty());
+  EXPECT_TRUE(roots.proxy.IsEmpty());
+  EXPECT_EQ(roots.cppgc.Get(),nullptr);
+  // Force pruning without resurrecting a collected proxy or guessing an address.
+  EXPECT_FALSE(isolate_data_->IsReservedOwnedGlobalProxy(Object::New(isolate_)));
+}
