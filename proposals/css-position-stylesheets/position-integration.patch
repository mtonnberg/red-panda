+test('same-block duplicate replacement preserves actual CSSOM state and exposes the initial position when no valid candidate remains',async t=>{const{w,d}=await fixture(t,'<style>.subject{position:relative;position:floating!important}</style><div class=subject></div>');const e=d.querySelector('.subject'),style=d.styleSheets[0].cssRules[0].style;assert.equal(style.position,'floating');assert.equal(style.cssText,'position: floating !important;');assert.equal(w.getComputedStyle(e).position,'static');assert.equal(e.offsetParent,d.body);});
+test('measured position initial reset and ignored inherited/variable keywords use the real cascade instead of CSSOM rewriting',async t=>{const{w,d}=await fixture(t,'<style>.parent{position:absolute}.subject{position:relative}</style><div class=parent><span class=subject></span></div>');const e=d.querySelector('.subject');for(const value of['inherit','unset','revert','revert-layer','var(--position, fixed)']){e.style.position=value;assert.equal(e.style.position,value);assert.equal(w.getComputedStyle(e).position,'relative');assert.equal(e.offsetParent,e.parentElement)}e.style.position='initial';assert.equal(e.style.position,'initial');assert.equal(w.getComputedStyle(e).position,'static');assert.equal(e.offsetParent,e.parentElement);});
