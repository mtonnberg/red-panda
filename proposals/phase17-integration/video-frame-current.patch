+test('actual Worker transport preserves immutable multi-plane pixels after sender closes',async t=>{const{page}=await fixture(t);const value=await page.evaluate(`new Promise((resolve,reject)=>{const source='onmessage=async e=>{const f=e.data,bytes=new Uint8Array(f.allocationSize()),layout=await f.copyTo(bytes);postMessage({brand:f instanceof VideoFrame,layout,bytes,copy:f.clone()})}',url=URL.createObjectURL(new Blob([source])),worker=new Worker(url),timer=setTimeout(()=>{worker.terminate();reject(Error('worker deadline'))},5000);worker.onerror=e=>{clearTimeout(timer);worker.terminate();reject(Error(e.message))};worker.onmessage=async e=>{clearTimeout(timer);const bytes=new Uint8Array(e.data.copy.allocationSize());await e.data.copy.copyTo(bytes);resolve({brand:e.data.brand,copy:e.data.copy instanceof VideoFrame,bytes:[...bytes],layout:e.data.layout});worker.terminate();URL.revokeObjectURL(url)};const f=new VideoFrame(new Uint8Array([1,2,3,4,5,6]),{format:'I420',codedWidth:2,codedHeight:2,timestamp:4});worker.postMessage(f);f.close()})`);assert.deepEqual(plain(value),{brand:true,copy:true,bytes:[1,2,3,4,5,6],layout:[{offset:0,stride:2},{offset:4,stride:1},{offset:5,stride:1}]})});
