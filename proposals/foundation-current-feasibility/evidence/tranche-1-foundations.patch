+test('original foundational public definitions and untouched methods are genuinely created in the selected VM',async t=>{const{w}=await fixture(t);for(const kind of kinds){realm(w[kind],w);realm(w[kind].prototype,w);assert.equal(w[kind].prototype.constructor,w[kind]);assert.throws(()=>w[kind](),e=>e instanceof w.TypeError)}for(const value of[w.Node.prototype.hasChildNodes,w.Element.prototype.hasAttributes,w.HTMLElement.prototype.click])realm(value,w);assert.equal(Object.getPrototypeOf(w.Node.prototype),w.EventTarget.prototype);assert.equal(Object.getPrototypeOf(w.Element.prototype),w.Node.prototype);assert.equal(Object.getPrototypeOf(w.HTMLElement.prototype),w.Element.prototype);});
+test('canonical factory exports/setup/cache and actual backend identities remain unchanged across installation',async t=>{const factories=kinds.map(kind=>require('jsdom/lib/jsdom/living/generated/'+kind+'.js')),setup=factories.map(factory=>factory.setup),{w}=await fixture(t);for(let i=0;i<kinds.length;i++){assert.equal(require('jsdom/lib/jsdom/living/generated/'+kinds[i]+'.js'),factories[i]);assert.equal(factories[i].setup,setup[i])}const e=w.document.getElementById('owned'),backend=utils.implForWrapper(e),nodes=e.childNodes,attrs=e.attributes;assert.equal(e.childNodes,nodes);assert.equal(e.attributes,attrs);assert.equal(utils.wrapperForImpl(backend),e);assert.equal(platformFactoryRecord(e).implementation,backend);e.appendChild(w.document.createTextNode('added'));e.setAttribute('data-owned','value');assert.equal(nodes.length,2);assert.equal(attrs.getNamedItem('data-owned').value,'value');const clone=e.cloneNode(true);assert.notEqual(clone,e);assert.equal(clone.textContent,'actualadded');assert.equal(clone.isEqualNode(e),true);});
+test('real custom element constructors and callbacks retain actual element/backend state',async t=>{const{w}=await fixture(t);const value=JSON.parse(w.eval(`JSON.stringify((()=>{const calls=[];class Actual extends HTMLElement{static get observedAttributes(){return['data-owned']}constructor(){super();this.owned='actual';calls.push('construct')}connectedCallback(){calls.push('connected')}attributeChangedCallback(name,old,value){calls.push(['attribute',name,old,value])}}customElements.define('owned-foundation',Actual);const e=new Actual();document.body.append(e);e.setAttribute('data-owned','one');return{calls,owned:e.owned,prototype:Object.getPrototypeOf(e)===Actual.prototype,node:e instanceof Node,element:e instanceof Element,html:e instanceof HTMLElement,owner:e.ownerDocument===document}})())`));assert.deepEqual(value,{calls:['construct','connected',['attribute','data-owned',null,'one']],owned:'actual',prototype:true,node:true,element:true,html:true,owner:true});});
+test('frame and utility definitions keep distinct actual realms without retargeting observed node wrappers',async t=>{const{w,page}=await fixture(t),c=w.document.querySelector('iframe').contentWindow;for(const kind of kinds)realm(c[kind].prototype,c);const e=c.document.createElement('div'),p=Object.getPrototypeOf(e),backend=utils.implForWrapper(e);w.document.adoptNode(e);w.document.body.append(e);assert.equal(e.ownerDocument,w.document);assert.equal(Object.getPrototypeOf(e),p);assert.equal(utils.implForWrapper(e),backend);realm(e,c);const world=createIsolatedWorld(w,{signal:page.documentAbort.signal});t.after(()=>world.dispose());for(const kind of kinds)realm(world.global[kind].prototype,world.global);const front=world.evaluate('document.getElementById("owned")'),main=w.document.getElementById('owned');assert.equal(canonicalUtilityValue(front),main);assert.equal(platformFactoryRecord(front).implementation,platformFactoryRecord(main).implementation);assert.equal(front.textContent,'actual');});
+test('genuine non-scriptable Host windows retain their original Host interfaces and functional DOM',()=>{const dom=new JSDOM('<div>actual</div>');try{const w=dom.window;for(const kind of kinds){assert.equal(binding.sameRealm(w[kind],[]),true);assert.equal(binding.sameRealm(w[kind].prototype,[]),true)}const e=w.document.querySelector('div');assert.equal(e.textContent,'actual');assert.equal(e instanceof w.Node,true);assert.equal(e instanceof w.Element,true);assert.equal(e instanceof w.HTMLElement,true);e.setAttribute('data-owned','value');assert.equal(e.getAttribute('data-owned'),'value')}finally{dom.window.close()}});
+test('exact source/body guards and frozen Input/additional/Option modules remain intact',()=>{for(const kind of kinds){const source=readFileSync(require.resolve('jsdom/lib/jsdom/living/generated/'+kind+'.js'),'utf8');assert.doesNotThrow(()=>transformFoundationalInterface(source,kind,source));assert.throws(()=>transformFoundationalInterface(source,kind,source+'\n'),/Pinned canonical foundational interface source changed/);assert.throws(()=>transformFoundationalInterface(source.replace('  const ctorRegistry =','  /* changed */const ctorRegistry ='),kind,source),/Canonical foundational public installer body changed/)}for(const[name,expected]of[['control-interface-realms.js','9562a190077d6af25b20740fe40e9044e7989f4e3be6952f1bd79a61b6bb5a3f'],['additional-control-interface-realms.js','62b1eb9a098e15c7613bcf3a75a0fb60e3fffa2d90a925ea986e844a9385d0bf'],['option-alias.js','0d55df0c73d6ce5413aaf3623abd8e7d3698fdda146ff694a97800bf113099f6']])assert.equal(createHash('sha256').update(readFileSync(new URL('../src/'+name,import.meta.url))).digest('hex'),expected)});
