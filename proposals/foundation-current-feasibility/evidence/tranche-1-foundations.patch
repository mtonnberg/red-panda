+import{Browser}from'../src/browser.js';import{getHeapBinding}from'../src/native-heap.js';import{platformFactoryRecord}from'../src/platform-factories.js';import{createIsolatedWorld,canonicalUtilityValue}from'../src/isolated-world.js';import{transformFoundationalInterface}from'../src/foundational-interface-realms.js';
+const require=createRequire(import.meta.url),utils=require('jsdom/lib/jsdom/living/generated/utils.js'),binding=getHeapBinding(),kinds=['Node','Element','HTMLElement'];
