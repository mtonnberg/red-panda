+  assert.equal(r.request.postData,mixed.toString('latin1'));assert.deepEqual(r.request.postDataEntries,[{bytes:mixed.toString('base64')}]);
+  assert.deepEqual(await s.send('Network.getRequestPostData',{requestId:r.id}),{postData:mixed.toString('latin1')});
+  const empty=await s.fetchOne('/echo?empty=1',"{method:'POST',body:''}");
+  assert.equal(empty.request.hasPostData,true);assert.equal(empty.request.postData,'');assert.deepEqual(empty.request.postDataEntries,[{bytes:''}]);
