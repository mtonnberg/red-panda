+    ['/text?type='+encodeURIComponent('text/plain; charset=utf8'),text,true],
+    ['/text?type='+encodeURIComponent('application/xml; charset=UTF-8'),text,true],
+    ['/text?type='+encodeURIComponent('text/plain; charset=UTF-8; charset=ISO-8859-1'),text,false],
+  ]){
+    const r=await s.fetchOne(path),body=await s.send('Network.getResponseBody',{requestId:r.id});
