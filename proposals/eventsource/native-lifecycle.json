  "expression": "(async()=>{const output=[];const e=new EventSource('/hold?key=main');await new Promise(r=>e.onmessage=r);window.close();output.push(['main-close',closed,e.readyState]);await new Promise(r=>setTimeout(r,40));e.close();output.push(['main-explicit-close',e.readyState]);const frame=document.createElement('iframe');frame.src='/frame';document.body.append(frame);await new Promise(r=>frame.onload=r);const fe=frame.contentWindow.eval(`globalThis.es=new EventSource('/hold?key=frame');es`);await new Promise(r=>fe.onmessage=r);frame.remove();output.push(['frame-remove',fe.readyState]);await new Promise(r=>setTimeout(r,40));output.push(['frame-later',fe.readyState]);const worker=new Worker('/worker.js');worker.postMessage(`new Promise(resolve=>{globalThis.es=new EventSource(${JSON.stringify(\"http://127.0.0.1:42465\"+'/hold?key=worker')});es.onmessage=()=>resolve(es.readyState)})`);output.push(['worker-open',await new Promise(r=>worker.onmessage=e=>r(e.data))]);worker.terminate();await new Promise(r=>setTimeout(r,60));return JSON.stringify(output)})()\n",
