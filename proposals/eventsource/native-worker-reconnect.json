  "expression": "(async()=>{const worker=new Worker('/worker.js');const body=(async()=>{const rows=[];for(const path of['/reconnect?key=plain','/redirect?code=301&to='+encodeURIComponent('/reconnect?key=redirect301'),'/redirect?code=302&to='+encodeURIComponent('/reconnect?key=redirect302'),'/eof?key=eof']){const events=[];await new Promise(resolve=>{const e=new EventSource(path);let errors=0;e.onopen=()=>events.push(['open',e.readyState,e.url.replace(\"http://127.0.0.1:39545\",'OWNED')]);e.onmessage=v=>events.push(['message',v.data,v.lastEventId,v.origin.replace(\"http://127.0.0.1:39545\",'OWNED')]);e.addEventListener('done',()=>{e.close();resolve()});e.onerror=()=>{events.push(['error',e.readyState]);if(++errors===2){e.close();resolve()}}});rows.push([path,events])}return JSON.stringify(rows)});worker.postMessage('('+body.toString()+')()');const result=await new Promise(resolve=>worker.onmessage=e=>resolve(e.data));worker.terminate();return JSON.stringify(result)})()\n",
