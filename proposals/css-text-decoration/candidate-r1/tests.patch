--- /dev/null
+++ b/test/computed-text-decoration.test.js
@@ -0,0 +1,5 @@
+import{test}from'node:test';import assert from'node:assert/strict';import{Browser}from'../src/browser.js';
+async function fixture(t){const browser=new Browser(),page=browser.createPage();t.after(()=>browser.close());await page.navigate('data:text/html,<body>');return{w:page.dom.window,d:page.dom.window.document};}
+test('text decoration defaults leave declarations untouched and reset a non-inherited line through the real cascade',async t=>{const{w,d}=await fixture(t),parent=d.createElement('div'),child=d.createElement('span');parent.style.textDecorationLine='overline';parent.append(child);d.body.append(parent);const held=w.getComputedStyle(child);assert.equal(w.getComputedStyle(parent).textDecorationLine,'overline');assert.equal(child.style.textDecorationLine,'');assert.equal(child.hasAttribute('style'),false);assert.equal(held.textDecorationLine,'none');assert.equal(held.textDecoration,'none');assert.equal(held.getPropertyValue('text-decoration-line'),'none');for(const[value,expected]of[['inherit','overline'],['initial','none'],['unset','none'],['revert','none']]){child.style.textDecorationLine=value;assert.equal(held.textDecorationLine,expected);assert.equal(child.style.textDecorationLine,value)}child.style.removeProperty('text-decoration-line');assert.equal(held.textDecorationLine,'none');assert.equal(w.getComputedStyle(parent).textDecorationLine,'overline')});
+test('actual inline mutation keeps Native verbatim longhand tokens and shorthand does not synthesize a line declaration',async t=>{const{w,d}=await fixture(t),e=d.createElement('span');d.body.append(e);const held=w.getComputedStyle(e);for(const value of['UNDERLINE','bogus','underline underline','none underline','overline underline']){e.style.setProperty('text-decoration-line',value);assert.equal(e.style.textDecorationLine,value);assert.equal(held.textDecorationLine,value);assert.equal(held.getPropertyValue('text-decoration-line'),value)}e.removeAttribute('style');for(const value of['underline','red wavy underline','underline 2px blue','bogus']){e.setAttribute('style','text-decoration:'+value);assert.equal(e.style.textDecoration,value);assert.equal(e.style.textDecorationLine,'');assert.equal(held.textDecoration,value);assert.equal(held.textDecorationLine,'none')}assert.throws(()=>held.setProperty('text-decoration-line','underline'),{name:'NoModificationAllowedError'});assert.equal(held.textDecorationLine,'none')});
+test('retained decoration values follow actual inactive adoption and later author changes without replacing the Attr',async t=>{const{w,d}=await fixture(t),inactive=d.implementation.createHTMLDocument('inactive'),e=d.createElement('span');e.style.textDecorationLine='underline';d.body.append(e);const held=w.getComputedStyle(e),a=e.getAttributeNode('style');assert.equal(held.textDecorationLine,'underline');inactive.adoptNode(e);assert.equal(e.getAttributeNode('style'),a);assert.equal(a.ownerDocument,inactive);assert.equal(e.style.textDecorationLine,'underline');assert.equal(held.textDecorationLine,'none');e.style.textDecorationLine='line-through';assert.equal(held.textDecorationLine,'none');d.body.append(e);assert.equal(e.getAttributeNode('style'),a);assert.equal(a.ownerDocument,d);assert.equal(held.textDecorationLine,'line-through')});
