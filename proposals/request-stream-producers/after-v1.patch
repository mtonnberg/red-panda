+
+test('fetched body provenance uses actual received bytes and preserves abort errors on the actual exposed source',async t=>{const{origin}=await server(t),w=fixture(t,origin),owner=await w.fetch(origin),echo=await(await w.fetch(origin,{method:'POST',body:owner.body})).json();assert.deepEqual(Array.from(echo.bytes),[0,255,65]);assert.equal(owner.bodyUsed,false);assert.deepEqual([...await owner.bytes()],[0,255,65]);const controller=new w.AbortController(),reason={exact:'abort'},aborted=await w.fetch(origin,{signal:controller.signal}),source=aborted.body;controller.abort(reason);await assert.rejects(source.getReader().read(),e=>e===reason);await assert.rejects(aborted.bytes(),e=>e===reason)});
