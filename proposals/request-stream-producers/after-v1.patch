+function fixture(t,origin='http://127.0.0.1/'){const page=Object.assign(new EventEmitter(),{closed:false,documentGeneration:0,documentAbort:new AbortController(),fetch:(url,options)=>globalThis.fetch(url,options)}),{window:w}=new JSDOM('<body></body>',{runScripts:'outside-only',url:origin});w.AbortController=globalThis.AbortController;w.AbortSignal=globalThis.AbortSignal;installFetch(page,w);t.after(()=>{page.documentAbort.abort();w.close()});return w}
+async function server(t){const requests=[],s=http.createServer(async(req,res)=>{const chunks=[];for await(const x of req)chunks.push(x);const bytes=Buffer.concat(chunks),row={method:req.method,bytes:[...bytes],type:req.headers['content-type']??null};requests.push(row);if(req.method==='GET'){res.setHeader('content-type','application/octet-stream');res.end(Buffer.from([0,255,65]));return}res.setHeader('content-type','application/json');res.end(JSON.stringify(row))});await new Promise(r=>s.listen(0,'127.0.0.1',r));t.after(async()=>{s.closeAllConnections();await new Promise(r=>s.close(r))});return{origin:`http://127.0.0.1:${s.address().port}/`,requests}}
+const child=(w,source)=>new w.Request('http://127.0.0.1/',{method:'POST',body:source});
+
+test('buffered Response and Request bodies are stable genuine closed queues from actual byte snapshots',async t=>{const w=fixture(t),source=new w.Uint8Array([0,255,65]);for(const owner of[new w.Response(source),new w.Request('http://127.0.0.1/',{method:'POST',body:source}),new w.Response(new w.Blob([source]))]){const stream=owner.body;assert.equal(stream,owner.body);assert.ok(stream instanceof w.ReadableStream);assert.equal(stream.locked,false);assert.deepEqual([...await child(w,stream).bytes()],[0,255,65]);assert.equal(owner.bodyUsed,false);assert.equal(stream.locked,true);await assert.rejects(owner.text(),e=>e instanceof w.TypeError&&e.message==='Body is disturbed or locked');assert.equal(owner.bodyUsed,false)}const empty=new w.Response('');assert.equal((await empty.body.getReader().read()).done,true)});
