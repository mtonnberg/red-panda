      "source": "(async()=>{const r=await fetch('http://localhost:9582/echo_headers',{headers:{'X-Hop':'route-positive'}});return {status:r.status,type:r.type,bodyHasHeader:(await r.text()).toLowerCase().includes('x-hop: route-positive')};})()",
