    {
      "name": "brotli-real-compressed-request-native-decoder",
      "source": "(async()=>{const bytes=new TextEncoder().encode('actual native brotli transport');const stream=new Blob([bytes]).stream().pipeThrough(new CompressionStream('brotli'));const compressed=await new Response(stream).arrayBuffer();const r=await fetch('/echo_brotli',{method:'POST',body:compressed});return [r.status,await r.text()];})()",
      "expected": [
        200,
        "actual native brotli transport"
      ],
      "result": [
        200,
        "actual native brotli transport"
      ],
      "passed": true
    },
    {
      "name": "gzip-exact-raw-bytes-native-decoder",
      "source": "(async()=>{const r=await fetch('/raw/gzip');return [r.status,r.headers.get('content-encoding'),(await r.text()).length];})()",
      "expected": [
        200,
        "gzip",
        1000
      ],
      "result": [
        200,
        "gzip",
        1000
      ],
      "passed": true
    },
    {
      "name": "websocket-single-text-binary-origin-close",
      "source": "new Promise(resolve=>{const seen=[],ws=new WebSocket('ws://127.0.0.1:9584/');const timer=setTimeout(()=>{ws.close();resolve({timeout:true,seen});},3000);ws.binaryType='arraybuffer';ws.onopen=()=>{seen.push('open');ws.send('actual');};ws.onmessage=e=>{if(typeof e.data==='string'){seen.push(e.data);if(e.data==='echo-actual')ws.send(new Uint8Array([1,2]));else ws.close(1000,'done');}else{seen.push(Array.from(new Uint8Array(e.data)));ws.send('get-origin');}};ws.onclose=e=>{clearTimeout(timer);seen.push([e.code,e.reason,e.wasClean]);resolve(seen);};ws.onerror=()=>seen.push('error');})",
      "expected": [
        "open",
        "echo-actual",
        [
          238,
          1,
          2
        ],
        "origin:http://127.0.0.1:9582",
        [
          1000,
          "done",
          true
        ]
      ],
      "result": [
        "open",
        "echo-actual",
        [
          238,
          1,
          2
        ],
        "origin:http://127.0.0.1:9582",
        [
          1000,
          "done",
          true
        ]
      ],
      "passed": true
    },
