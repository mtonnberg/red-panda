+  timeout=re.search(r'\.timeout_ms\s*=\s*(\d+)',options);timeout=int(timeout[1]) if timeout else 2000
+  inject=re.search(r'\.inject_script\s*=\s*("(?:\\.|[^"\\])*")',options);inject=json.loads(inject[1]) if inject else None
