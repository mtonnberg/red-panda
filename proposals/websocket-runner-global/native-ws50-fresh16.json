  "expression": "(async()=>{const jobs=[];for(let i=0;i<16;i++)jobs.push(new Promise(resolve=>{const events=[],ws=new WebSocket(\"ws://127.0.0.1:43993\"+'/?i='+i),timer=setTimeout(()=>{ws.close();resolve({i,events,timeout:true})},3000);ws.onopen=()=>{events.push('open');ws.send('genuine-'+i)};ws.onmessage=e=>{events.push(e.data);ws.close(1000,'actual')};ws.onerror=()=>events.push('error');ws.onclose=e=>{clearTimeout(timer);events.push(['close',e.code,e.wasClean]);resolve({i,events})}}));return JSON.stringify(await Promise.all(jobs))})()\n",
