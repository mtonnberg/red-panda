diff --git a/proposals/websocket-runner-global/probe-v2.mjs b/proposals/websocket-runner-global/probe-v2.mjs
new file mode 100644
--- /dev/null
+++ b/proposals/websocket-runner-global/probe-v2.mjs
@@ -0,0 +1 @@
+import http from'node:http';import{once}from'node:events';import{startReference}from'../scripts/reference-server.mjs';import{startFixtureWebSocket}from'../scripts/upstream-fixture-websocket.mjs';import{connect}from'../test/cdp-client.js';import{readFile,writeFile}from'node:fs/promises';import{createHash}from'node:crypto';const extraArgs=process.argv.slice(5);const binary=process.argv[2],file=process.argv[3],output=process.argv[4],source=await readFile(new URL('./'+file,import.meta.url),'utf8');const server=http.createServer((q,s)=>{s.setHeader('content-type','text/html');s.end('<!doctype html><body>Owned WebSocket diagnostics')});server.listen(0,'127.0.0.1');await once(server,'listening');const origin='http://127.0.0.1:'+server.address().port,ws=await startFixtureWebSocket({port:0}),expression=source.replaceAll('ENDPOINT',JSON.stringify(ws.origin));let browser,client;try{browser=await startReference(binary,{args:['--load-resources','iframe','--load-resources','worker',...extraArgs]});client=await connect(browser.endpoint);const{targetId}=await client.send('Target.createTarget',{url:'about:blank'}),{sessionId}=await client.send('Target.attachToTarget',{targetId,flatten:true}),send=(m,p)=>client.send(m,p,sessionId);await send('Runtime.enable',{});await send('Page.navigate',{url:origin});const result=await send('Runtime.evaluate',{expression,returnByValue:true,awaitPromise:true});await writeFile(output,JSON.stringify({binarySHA256:createHash('sha256').update(await readFile(binary)).digest('hex'),driverSHA256:createHash('sha256').update(await readFile(new URL(import.meta.url))).digest('hex'),sourceSHA256:createHash('sha256').update(source).digest('hex'),helperSHA256:createHash('sha256').update(await readFile(new URL('../scripts/upstream-fixture-websocket.mjs',import.meta.url))).digest('hex'),origin,extraArgs,endpoint:ws.origin,expression,result,requests:ws.requests,stderr:browser.stderr,events:client.events},null,2)+'\n',{flag:'wx'});console.log('Saved',output)}finally{await client?.close();await browser?.close();await ws.close();server.closeAllConnections();await new Promise(r=>server.close(r))}
