+import http from'node:http';import https from'node:https';import{once}from'node:events';import{readFile,writeFile}from'node:fs/promises';import{createHash,randomUUID}from'node:crypto';import{startReference}from'../scripts/reference-server.mjs';import{connect}from'../test/cdp-client.js';const binary=process.argv[2],output=process.argv[3],extraArgs=process.argv.slice(4),value='owned-tls-'+randomUUID(),requests=[],cert=await readFile(new URL('tls-control.crt',import.meta.url)),tls=https.createServer({key:await readFile(new URL('tls-control.key',import.meta.url)),cert},(q,s)=>{requests.push({url:q.url,headers:q.rawHeaders});s.setHeader('access-control-allow-origin','*');s.end(value)}),server=http.createServer((q,s)=>{s.setHeader('content-type','text/html');s.end('<!doctype html><body>Owned TLS globals')});tls.listen(0,'127.0.0.1');server.listen(0,'127.0.0.1');await Promise.all([once(tls,'listening'),once(server,'listening')]);const target='https://127.0.0.1:'+tls.address().port,origin='http://127.0.0.1:'+server.address().port;let browser,client;try{browser=await startReference(binary,{args:extraArgs});client=await connect(browser.endpoint);const{targetId}=await client.send('Target.createTarget',{url:'about:blank'}),{sessionId}=await client.send('Target.attachToTarget',{targetId,flatten:true}),send=(m,p)=>client.send(m,p,sessionId);await send('Page.navigate',{url:origin});const expression=`(async()=>{try{return JSON.stringify({ua:navigator.userAgent,value:await(await fetch(${JSON.stringify(target)})).text()})}catch(e){return JSON.stringify({ua:navigator.userAgent,error:e.name,message:e.message})}})()`,result=await send('Runtime.evaluate',{expression,returnByValue:true,awaitPromise:true});await writeFile(output,JSON.stringify({binarySHA256:createHash('sha256').update(await readFile(binary)).digest('hex'),driverSHA256:createHash('sha256').update(await readFile(new URL(import.meta.url))).digest('hex'),certificateSHA256:createHash('sha256').update(cert).digest('hex'),extraA