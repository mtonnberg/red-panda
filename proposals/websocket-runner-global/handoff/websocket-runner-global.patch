+(async()=>{const serial=[],run=(label,data,commands=[])=>new Promise(resolve=>{const events=[],ws=new WebSocket(ENDPOINT+'/?case='+label);ws.binaryType='arraybuffer';const timer=setTimeout(()=>{ws.close();resolve({label,events,timeout:true})},3000);ws.onopen=()=>{events.push(['open',ws.readyState]);ws.send(data);for(const text of commands)ws.send(text)};ws.onmessage=e=>{events.push(['message',typeof e.data==='string'?e.data:Array.from(new Uint8Array(e.data))]);ws.close(1000,'done')};ws.onerror=()=>events.push(['error',ws.readyState]);ws.onclose=e=>{clearTimeout(timer);events.push(['close',e.code,e.reason,e.wasClean]);resolve({label,events})}});for(const[label,data]of[['text','hello'],['u8',new Uint8Array([1,2,3,4,5])],['buffer',new Uint8Array([10,20,30,40]).buffer],['i32',new Int32Array([0x01020304,0x05060708])],['blob',new Blob(['hello'])],['large','send-large:10000'],['server-close','close:1001:going away'],['cookie','get-cookie'],['origin','get-origin']]){document.cookie='ws_token=session_xyz; path=/';serial.push(await run(label,data))}return JSON.stringify(serial)})()
