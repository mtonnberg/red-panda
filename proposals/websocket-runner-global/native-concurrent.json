  "expression": "(async()=>{const rows=[];for(const count of[4,8,16,32]){const jobs=[];for(let i=0;i<count;i++)jobs.push(new Promise(resolve=>{const events=[],ws=new WebSocket(\"ws://127.0.0.1:37611\"+'/?count='+count+'&i='+i),timer=setTimeout(()=>{ws.close();resolve({i,events,timeout:true})},3000);ws.onopen=()=>{events.push('open');ws.send('case-'+i)};ws.onmessage=e=>{events.push(e.data);ws.close(1000,'done')};ws.onerror=()=>events.push('error');ws.onclose=e=>{clearTimeout(timer);events.push(['close',e.code,e.wasClean]);resolve({i,events})}}));rows.push({count,rows:await Promise.all(jobs)})}return JSON.stringify(rows)})()\n",
