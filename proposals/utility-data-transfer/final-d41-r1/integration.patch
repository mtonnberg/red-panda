+module Test.Upload (uploadChecks) where
+
+import Prelude
+
+import Data.Either (Either(..))
+import Effect.Aff (Aff, attempt, bracket, throwError)
+import Effect.Class (liftEffect)
+import Effect.Class.Console (log)
